{
  "lock": false,
  "fmt": {
    "useTabs": true,
    "singleQuote": true
  },
  "tasks": {
    "server": "deno run --allow-net=0.0.0.0,ra101.dev,alias-alchemy.ra101.dev:80 --allow-read server.ts",
    "dev-server": "deno run --allow-net=:8080 --allow-read --watch server.ts server.ts --debug",
    "docs": "deno run --allow-write --allow-read update_docs.ts",
    "pretty": "deno fmt *.ts && deno lint ."
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.8"
  }
}