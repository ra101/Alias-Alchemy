{
  "lock": false,
  "fmt": {
    "useTabs": true,
    "singleQuote": true
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-read --watch server.ts server.ts",
    "docs": "deno run --allow-write --allow-read update_docs.ts",
    "pretty": "deno fmt *.ts && deno lint ."
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.8"
  },
  "deploy": {
    "project": "alias",
    "entrypoint": "server.ts",
    "exclude": [
      ".git",
      "CNAME",
      "git_hooks.sh"
    ]
  }
}