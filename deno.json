{
	"lock": false,
	"fmt": {
		"useTabs": true,
		"singleQuote": true
	},
	"tasks": {
		"server": "deno run --allow-net=:80 --allow-read server.ts",
		"dev-server": "deno run --allow-net=:8080 --allow-read server.ts --debug",
		"docs": "deno run --allow-write --allow-read update_docs.ts",
		"pretty": "deno fmt *.ts && deno lint ."
	},
	"imports": {
		"@std/path": "jsr:@std/path@^1.0.8"
	}
}
